@prefix :        <https://github.com/Senckenberg-Nature-Research-SDEI/lm_embeddings_4_species/gbif_dataset/> .

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

:catalog
    a                    dcat:Catalog ;
    dct:title            "GBIF Taxonomic Synonym Datasets for LM Embedding Evaluation"@en ;
    dct:description      "A collection of CSV datasets derived from GBIF (Global Biodiversity Information Facility) containing accepted species names paired with their synonyms across six taxonomic groups. Used to benchmark pretrained language-model embeddings for zero-shot species-synonym detection."@en ;
    dct:publisher        <https://www.senckenberg.de/> ;
    dct:license          <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dct:language         <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dct:issued           "2024-01-01"^^xsd:date ;
    dcat:dataset
        :ds-balanced-coleop ,
        :ds-balanced-fabales ,
        :ds-balanced-lamiales ,
        :ds-balanced-lepidoptera ,
        :ds-balanced-poales ,
        :ds-balanced-rosales ,
        :ds-taxa-coleoptera ,
        :ds-taxa-fabales ,
        :ds-taxa-lamiales ,
        :ds-taxa-lepidoptera ,
        :ds-taxa-lepidoptera-all ,
        :ds-taxa-poales ,
        :ds-taxa-rosales ;
    foaf:homepage        <https://github.com/Senckenberg-Nature-Research-SDEI/lm_embeddings_4_species> .

# ---------------------------------------------------------------------------
# Balanced synonym datasets  (label = 1 → synonym, 0 → non-synonym)
# Columns: oldSpeciesCanonicalName, species, key, label
# ---------------------------------------------------------------------------

:ds-balanced-coleop
    a                    dcat:Dataset ;
    dct:title            "Balanced Synonym Dataset – Coleoptera"@en ;
    dct:description      "Balanced binary-labelled pairs of species canonical names (old/synonym vs. accepted) for the order Coleoptera (beetles), derived from GBIF. Suitable for evaluating embedding-based synonym classifiers."@en ;
    dct:subject          <http://www.wikidata.org/entity/Q1351> ;   # Coleoptera
    dct:license          <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dct:source           <https://www.gbif.org/> ;
    schema:keywords      "Coleoptera", "beetles", "taxonomy", "synonym", "GBIF", "biodiversity" ;
    dcat:distribution    :dist-balanced-coleop .

:dist-balanced-coleop
    a                    dcat:Distribution ;
    dct:title            "balanced_synonym_coleop_dataset.csv"@en ;
    dcat:mediaType       "text/csv" ;
    dcat:byteSize        "0"^^xsd:nonNegativeInteger ;   # update if known
    dcat:downloadURL     <balanced_synonym_coleop_dataset.csv> ;
    schema:numberOfRows  546 ;
    dct:description      "Columns: oldSpeciesCanonicalName, species, key, label"@en .

